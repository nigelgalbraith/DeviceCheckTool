  "title": "Acer Windows Device Check",
  "description": "Generic device check for Acer Windows computers.",
  "categories": [
    {
      "id": "system",
      "title": "System",
      "checks": [
        {
          "id": "os_version",
          "label": "OS Version",
          "type": "text",
          "allowNA": false,
          "weight": 0
        },
        {
          "id": "windows_activated",
          "label": "Windows Activated",
          "type": "yes_no",
          "allowNA": false,
          "weight": 1,
          "rules": {
            "yes": {
              "score": 100
            },
            "no": {
              "score": 0,
              "issue": "Windows is not activated.",
              "recommendation": "Activate Windows with a valid licence."
            }
          }
        },
        {
          "id": "acer_care_center_checked",
          "label": "Acer Care Center Checked",
          "type": "yes_no",
          "allowNA": true,
          "weight": 1,
          "rules": {
            "yes": {
              "score": 100
            },
            "no": {
              "score": 75
            }
          }
        }
      ]
    },
    {
      "id": "storage",
