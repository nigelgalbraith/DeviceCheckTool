{
  "id": "android-samsung",
  "title": "Samsung Android Device Check",
  "description": "Generic device check for Samsung Android phones.",
  "categories": [
    {
      "id": "system",
      "title": "System",
      "checks": [
        {
          "id": "android_version",
          "label": "Android Version",
          "type": "text",
          "allowNA": false,
          "weight": 0
        },
        {
          "id": "samsung_device_care_checked",
          "label": "Samsung Device Care Checked",
          "type": "yes_no",
          "allowNA": true,
          "weight": 1,
          "rules": {
            "yes": {
              "score": 100
            },
            "no": {
              "score": 75
            }
          }
        }
      ]
    },
    {
      "id": "storage",
      "title": "Storage",
      "checks": [
        {
          "id": "storage_used",
          "label": "Storage Used",
          "type": "percentage",
          "unit": "%",
          "allowNA": false,
          "weight": 1,
          "rules": [
            {
              "min": 0,
              "max": 74,
              "score": 100
            },
            {
              "min": 75,
              "max": 84,
              "score": 75,
              "issue": "Storage usage is becoming high.",
              "recommendation": "Consider freeing unused files and applications."
            },
            {
              "min": 85,
              "max": 94,
              "score": 40,
              "issue": "Storage usage is high.",
              "recommendation": "Free up storage or move data to another drive."
            },
            {
              "min": 95,
              "max": 100,
              "score": 10,
              "issue": "Storage is critically full.",
              "recommendation": "Free storage as soon as possible."
            }
          ]
        },
        {
          "id": "free_storage",
          "label": "Free Storage",
          "type": "number",
          "unit": "GB",
          "allowNA": false,
          "weight": 1,
          "rules": [
            {
              "min": 50,
              "score": 100
            },
            {
              "min": 20,
              "max": 49,
              "score": 70,
              "issue": "Free storage is limited.",
              "recommendation": "Remove unused files or applications before storage becomes constrained."
            },
            {
              "min": 0,
              "max": 19,
              "score": 30,
              "issue": "Free storage is low.",
              "recommendation": "Free up storage before returning the device to use."
            }
          ]
        }
      ]
    },
